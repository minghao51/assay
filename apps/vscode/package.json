{
  "name": "@assay/vscode",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "displayName": "Assay dataset viewer",
  "description": "Assay VS Code extension — production dataset surface (PT-V slice 1 ptv1-3): command + custom read-only editor for Parquet/CSV/JSONL/JSON/Arrow with a vendored local-first engine in the webview, plus the R4 webview feasibility spike harness (ptv-1)",
  "publisher": "assay-spike",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=22"
  },
  "main": "./dist/extension.cjs",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "assay.dataset.open",
        "title": "Assay: Open dataset"
      },
      {
        "command": "assay.spike.run",
        "title": "Assay: Run R4 webview feasibility spike"
      }
    ],
    "customEditors": [
      {
        "viewType": "assay.datasetViewer",
        "displayName": "Assay dataset viewer",
        "selector": [
          {
            "filenamePattern": "*.parquet"
          },
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.jsonl"
          },
          {
            "filenamePattern": "*.ndjson"
          },
          {
            "filenamePattern": "*.json"
          },
          {
            "filenamePattern": "*.arrow"
          },
          {
            "filenamePattern": "*.feather"
          },
          {
            "filenamePattern": "*.ipc"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:spike": "node scripts/build.mjs",
    "provision:vscode": "node scripts/provision-vscode.mjs",
    "generate:fixture": "node scripts/generate-fixture.mjs",
    "generate:fixtures": "node scripts/generate-fixtures.mjs",
    "run:spike": "node scripts/run-spike.mjs",
    "e2e": "node scripts/run-e2e.mjs",
    "test:runtime": "node --test test/vscode-runtime.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json"
  },
  "devDependencies": {
    "@assay/contracts": "workspace:*",
    "@assay/domain": "workspace:*",
    "@assay/engine-duckdb": "workspace:*",
    "@assay/validation": "workspace:*",
    "@assay/grid": "workspace:*",
    "@duckdb/duckdb-wasm": "^1.32.0",
    "@types/node": "catalog:",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minghao51/assay.git"
  },
  "homepage": "https://github.com/minghao51/assay#readme",
  "bugs": "https://github.com/minghao51/assay/issues"
}
