{
  "name": "@assay/cli",
  "version": "0.0.0",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minghao51/assay.git",
    "directory": "apps/cli"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "assay": "./dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "publishConfig": {
    "bin": {
      "assay": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc --build tsconfig.build.json && chmod +x dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@assay/contracts": "workspace:*",
    "@assay/diff": "workspace:*",
    "@assay/domain": "workspace:*",
    "@assay/engine-duckdb": "workspace:*",
    "@assay/pipeline": "workspace:*",
    "@assay/telemetry": "workspace:*",
    "@assay/validation": "workspace:*",
    "@duckdb/node-api": "1.5.5-r.5",
    "apache-arrow": "17.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "homepage": "https://github.com/minghao51/assay#readme",
  "bugs": "https://github.com/minghao51/assay/issues"
}
