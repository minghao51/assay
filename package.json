{
  "name": "assay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Assay — the local-first data workbench (monorepo root)",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm exec tsc --build apps/cli/tsconfig.build.json && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dev": "pnpm --filter @assay/web dev",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "catalog:",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "turbo": "^2.11.2",
    "typescript": "catalog:",
    "typescript-eslint": "^8.35.0",
    "vitest": "catalog:"
  }
}
