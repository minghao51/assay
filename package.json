{
  "name": "assay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Assay — the local-first data workbench (monorepo root)",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "adr:index": "node scripts/generate-adr-index.mjs",
    "adr:index:check": "node scripts/generate-adr-index.mjs --check",
    "docs:links": "node scripts/check-doc-links.mjs",
    "docs:links:check": "node scripts/check-doc-links.mjs",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm exec tsc --build apps/cli/tsconfig.build.json && vitest run",
    "test:coverage": "pnpm exec tsc --build apps/cli/tsconfig.build.json && vitest run --coverage --testTimeout=20000",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dev": "pnpm --filter @assay/web dev",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "^10.11.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.8",
    "turbo": "^2.11.3",
    "typescript": "catalog:",
    "typescript-eslint": "^8.70.1",
    "vitest": "catalog:"
  }
}
