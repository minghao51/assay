{
  "name": "@assay/engine-duckdb",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      }
    }
  },
  "//": "dist/ is shared by two builds (see vite.config.ts): the vite e2e harness emits index.html + assets/ + fixtures/ into dist/, while tsc emits the library at the dist root. The flat (non-recursive) files globs below are deliberate: they match only the library's top-level emit and exclude the harness's nested output, so the packed tarball stays library-only.",
  "files": [
    "dist/*.js",
    "dist/*.js.map",
    "dist/*.d.ts",
    "dist/*.d.ts.map"
  ],
  "scripts": {
    "build": "vite build && tsc --build tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@assay/contracts": "workspace:*",
    "@assay/diff": "workspace:*",
    "@assay/engine": "workspace:*",
    "@assay/testing": "workspace:*",
    "@assay/validation": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "dependencies": {
    "@assay/domain": "workspace:*",
    "apache-arrow": "17.0.0",
    "@duckdb/duckdb-wasm": "^1.32.0"
  },
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minghao51/assay.git"
  },
  "homepage": "https://github.com/minghao51/assay#readme",
  "bugs": "https://github.com/minghao51/assay/issues"
}
