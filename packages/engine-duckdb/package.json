{
  "name": "@assay/engine-duckdb",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      }
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.js.map",
    "dist/*.d.ts",
    "dist/*.d.ts.map"
  ],
  "scripts": {
    "build": "vite build && tsc --build tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@assay/contracts": "workspace:*",
    "@assay/diff": "workspace:*",
    "@assay/testing": "workspace:*",
    "@assay/validation": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "dependencies": {
    "@assay/domain": "workspace:*",
    "apache-arrow": "17.0.0",
    "@duckdb/duckdb-wasm": "^1.32.0"
  }
}
