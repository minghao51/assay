# Assay environment variables — placeholders only.
#
# Copy what you need into your own `.env` (or export it in your shell); never
# commit a real value. `.env` is git-ignored, this file is not.
#
# GitHub Actions deploy credentials are NOT environment variables and must
# never appear in a `.env` file: `NETLIFY_AUTH_TOKEN` and `NETLIFY_SITE_ID`
# belong in the repository's Actions secrets, read only by
# `.github/workflows/netlify-collector.yml`.
#
# The collector site's canonical origin is a repository VARIABLE, not a secret and
# not a `.env` value: `ASSAY_COLLECTOR_URL` (e.g.
# `https://assay-dataworkbench.netlify.app`). The workflow's `verify-production`
# job probes it on every push to `main` (ADR 0054); a missing variable fails that
# job rather than skipping it, so set it before relying on the alarm.

# ---------------------------------------------------------------------------
# App build-time (Vite inlines these; the stock build stays inert without them)
# ---------------------------------------------------------------------------
# The collector endpoint the app sends to. Set it when building the app, after
# the function is deployed. No default is baked into the source: unset means
# nothing is constructed, buffered or sent.
ASSAY_TELEMETRY_ENDPOINT=https://<collector-site>.example/.netlify/functions/collect

# Optional bearer token sent with each batch. It is compiled into the browser
# bundle, so it is PUBLIC — it is a spam filter, never a secret or a security
# boundary. It must match the collector's ASSAY_TELEMETRY_INGEST_TOKEN when
# that is configured.
ASSAY_TELEMETRY_TOKEN=<public-ingest-token>

# ---------------------------------------------------------------------------
# Collector runtime (Netlify site environment variables — NOT GitHub secrets)
# ---------------------------------------------------------------------------
# Enables the ingest-token check in netlify/functions/collect.ts. Set it to the
# same value as the app's ASSAY_TELEMETRY_TOKEN. Unset leaves the endpoint
# open (the deployed-or-not default); set refuses a missing/mismatched bearer
# token with 401. Because the app-side value is public, this is a spam filter,
# not authentication. Never logged or echoed.
ASSAY_TELEMETRY_INGEST_TOKEN=<public-ingest-token>

# Optional comma-separated exact origins allowed to call the collector
# cross-origin. Unset means same-origin only; a wildcard is never sent.
ASSAY_TELEMETRY_ALLOWED_ORIGINS=https://<app-origin>.example

# ---------------------------------------------------------------------------
# Local / testing only (not a deployment configuration)
# ---------------------------------------------------------------------------
# The user-facing telemetry opt-out, read at RUNTIME by the CLI (and at build
# time by the web app, where it hard-disables telemetry). Any non-empty value —
# including 0 or false — turns telemetry off. It is a runtime user toggle, not a
# build knob.
ASSAY_NO_TELEMETRY=1

# Absolute path to the pinned DuckDB CLI binary. The engine agreement suites
# skip when it is missing; set it (e.g. /tmp/duckdb) to run the full suite
# instead of silently skipping 76 agreement tests.
DUCKDB=/tmp/duckdb
